# Names only. Never commit values. Copy to .env and fill in locally.
#
# Addresses, chain ids and RPC URLs are NOT set here. They come from packages/config/networks.ts:
#   eval "$(node packages/config/print-env.ts robinhoodTestnet)"
# which exports CHAIN_ID, RPC_URL, POOL_MANAGER, POSITION_MANAGER, PERMIT2, USDG,
# RH_TESTNET_RPC and STOCK_<SYMBOL> for the chosen network.

# Who receives the protocol share, and who can pause new advances (the protocol multisig)
TREASURY=
ADMIN=

# Pool launch: the protocol share of every Upfront fee for new pools, in basis points
PROTOCOL_SHARE_BPS=

# Advance desk. Testnet defaults are built in (days instead of weeks); on mainnet set every one explicitly.
PERIOD_DAYS=
MIN_HISTORY_DAYS=
MIN_PERIOD_EARNINGS=
BEHIND_AFTER_DAYS=
POOL_CAP=
MAX_VAULT_SHARE_BPS=
REPAY_SHARE_BPS=
